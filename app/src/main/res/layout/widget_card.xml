<?xml version="1.0" encoding="utf-8"?>
<!-- 4x2: the cover washed across the card, big cover, song and large controls -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wg_bg">

    <ImageView
        android:id="@+id/wg_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.55"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:src="@drawable/wg_scrim"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:id="@+id/wg_cover"
        android:src="@mipmap/ic_launcher"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/wg_label"
                android:text="Guava"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:textColor="#FF5B9DFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wg_title"
            android:text="Guava Player"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wg_artist"
            android:text="Tap to start the music"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#B3FFFFFF"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/wg_prev"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/wg_soft_circle"
                    android:contentDescription="Previous"
                    android:src="@drawable/wg_prev" />

                <FrameLayout
                    android:id="@+id/wg_play"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginHorizontal="10dp">

                    <ImageView
                        android:id="@+id/wg_play_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:src="@drawable/wg_circle"
            android:tint="#FF5B9DFF" />

                    <ImageView
                        android:id="@+id/wg_play_icon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:contentDescription="Play or pause"
                        android:src="@drawable/wg_play"
            android:tint="#FF0A1428" />
                </FrameLayout>

                <ImageButton
                    android:id="@+id/wg_next"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/wg_soft_circle"
                    android:contentDescription="Next"
                    android:src="@drawable/wg_next" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
